{
	"$schema": "https://raw.githubusercontent.com/gotgenes/pi-autoformat/main/schemas/pi-autoformat.schema.json",
	"formatters": {
		"bun": {
			"command": ["bun", "fmt"]
		}
	},
	"chains": {
		".ts": ["bun"],
		".tsx": ["bun"],
		".js": ["bun"],
		".jsx": ["bun"],
		".json": ["bun"],
		".css": ["bun"],
		".html": ["bun"],
		".md": ["bun"],
		".toml": ["bun"],
		".yaml": ["bun"],
		".yml": ["bun"]
	}
}
